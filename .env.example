# Southpay agentic-commerce API. Base URL defaults to production
# (https://api.southpay.io); only set this to point at another environment.
# SOUTHPAY_BASE_URL=https://api.southpay.io
# TEST-mode agent credential. Payments tools need payments:read + payments:write.
# The token + payout tools additionally need
# assets:read assets:write payouts:read payouts:write. Do not commit a real key.
SOUTHPAY_AGENT_KEY=spa_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The MCP server uses only the two variables above. The OpenClaw example in
# openclaw/ configures its own model through OpenClaw (openclaw models), not here.
