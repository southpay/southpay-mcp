{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "southpay-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mcp.southpay.io",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "alias": {
    "ai": "./src/ai-stub.ts",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SouthpayMCP",
        "class_name": "SouthpayMCP",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SouthpayMCP"],
    },
  ],
  "vars": {
    "SOUTHPAY_BASE_URL": "https://api.southpay.io",
  },
}
